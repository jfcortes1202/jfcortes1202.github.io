---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV & Resume" description="Academic CV and industry resume — Juan Cortés." currentPage="/cv">
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">CV &amp; Resume</p>
      <h1 class="hero__title">Curriculum Vitae</h1>
      <div class="hero__actions" style="margin-top:1.5rem;">
        <a href="/cv/resume.pdf" class="btn btn--primary" download>
          ↓ Download Resume (1 page)
        </a>
        <a href="/cv/cv-full.pdf" class="btn btn--outline" download>
          ↓ Download Full CV
        </a>
      </div>
      <p style="color:var(--text-tertiary); font-size:0.85rem; margin-top:0.75rem;">
        Last updated: November 2026
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <!-- Web-rendered CV -->
      <div class="fade-in">
        <h2>Education</h2>
        <div style="margin-bottom:1.5rem;">
          <h3 style="margin-bottom:0.25rem;">University of Maryland, College Park</h3>
          <p style="color:var(--text-secondary); margin-bottom:0.25rem;">
            B.S. Mechanical Engineering &amp; B.S. Physics · August 2024 – May 2028 (expected)
          </p>
          <p><strong>GPA:</strong> 3.97 / 4.00 · Dean's List (Fall 2024 – present)</p>
        </div>
      </div>

      <div class="fade-in">
        <h2>Research Experience</h2>
        <div style="margin-bottom:1rem;">
          <h3 style="margin-bottom:0.25rem;">Research Intern</h3>
          <p style="color:var(--text-secondary); margin-bottom:0.5rem;">
            University of Tennessee Space Institute · June 2026 – Present
          </p>
          <p>
            Advisor: Dr. Esteban Cisneros-Garibay. Computational FSI simulation of bat flight.
            Extended existing codebase from 2D to 3D flapping models with membrane perforations.
            Firedrake/PETSc, Gmsh, HPC with Slurm.
          </p>
        </div>
      </div>

      <div class="fade-in">
        <h2>Leadership</h2>
        <div style="margin-bottom:1rem;">
          <h3 style="margin-bottom:0.25rem;">Co-Lead, Myoelectric Mechanical Team</h3>
          <p style="color:var(--text-secondary); margin-bottom:0.5rem;">
            Accessible Prosthetics Initiative, UMD · Fall 2025 – Present (Co-Lead since Fall 2026)
          </p>
          <p>
            Leading ~6-person subteam designing a myoelectric prosthetic hand.
            SolidWorks design of housing and two-joint thumb mechanism.
          </p>
        </div>
      </div>

      <div class="fade-in">
        <h2>Teaching</h2>
        <div style="margin-bottom:1rem;">
          <h3 style="margin-bottom:0.25rem;">STEM Tutor</h3>
          <p style="color:var(--text-secondary); margin-bottom:0.5rem;">
            ClubZ In-Home Tutoring · May 2025 – Present
          </p>
          <p>
            One-on-one tutoring: AP Physics 1, Differential Equations, Statics for Engineers.
          </p>
        </div>
      </div>

      <div class="fade-in">
        <h2>Scholarships &amp; Awards</h2>
        <ul style="padding-left:1.25rem; line-height:1.8; color:var(--text-secondary);">
          <li>Professor William M. MacDonald Physics Endowed Scholarship</li>
          <li>CMNS Undergraduate Scholarship Fund</li>
          <li>Maria and Michael Korsnick Nuclear Engineering Innovation Award</li>
          <li>Angelo Bardasis Fellowship</li>
        </ul>
      </div>

      <div class="fade-in">
        <h2>Technical Skills</h2>
        <p>
          <strong>Programming:</strong> Python, MATLAB<br />
          <strong>Simulation:</strong> Firedrake, PETSc, FEM, Gmsh, VisIt, EES<br />
          <strong>CAD:</strong> SolidWorks (parts, assemblies, drawings, static FEA)<br />
          <strong>DevOps:</strong> Git/GitHub, HPC with Slurm, Linux CLI<br />
          <strong>Hardware:</strong> Arduino, breadboarding, oscilloscope, multimeter<br />
          <strong>Documentation:</strong> LaTeX/Overleaf/Beamer, technical writing, Excel
        </p>
      </div>

      <div class="fade-in">
        <h2>Relevant Coursework</h2>
        <p style="color:var(--text-secondary);">
          Multivariable Calculus · Linear Algebra · Differential Equations I–II (Honors) ·
          Mechanics I–II · Thermodynamics · Dynamics · Classical Mechanics · E&amp;M I–II ·
          Modern Physics · Quantum Physics I–II · Experimental Physics I &amp; III ·
          Electronics &amp; Instrumentation · Computational Fundamentals · CAD ·
          Statistical Methods · Technical Writing
        </p>
      </div>

      <!-- Download reminder -->
      <div class="fade-in" style="margin-top:3rem; text-align:center;">
        <p style="color:var(--text-tertiary); margin-bottom:1rem;">Need a downloadable version?</p>
        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a href="/cv/resume.pdf" class="btn btn--primary" download>↓ Resume (1 page)</a>
          <a href="/cv/cv-full.pdf" class="btn btn--outline" download>↓ Full CV</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
