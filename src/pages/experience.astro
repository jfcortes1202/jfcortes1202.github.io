---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Experience" description="Research, leadership, and teaching experience." currentPage="/experience">
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">Experience</p>
      <h1 class="hero__title">Research, Leadership &amp; Teaching</h1>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <!-- Research -->
      <div class="timeline-item fade-in">
        <h3>Research Intern — UTSI</h3>
        <p class="meta">University of Tennessee Space Institute · June 2026 – Present · Remote</p>
        <p>
          Working under <strong>Dr. Esteban Cisneros-Garibay</strong> on computational
          fluid-structure interaction (FSI) simulation of bat flight. Extended and validated
          an existing FSI codebase, progressing from 2D flow models to full 3D flapping
          bat-wing simulations with membrane perforations.
        </p>
        <ul style="padding-left:1.25rem; color:var(--text-secondary); line-height:1.7; font-size:0.95rem;">
          <li>Extended 2D flow + 1D filament model to 3D bat-wing with perforations</li>
          <li>Debugged mesh inversion, fixed traction integral formulation, implemented Gaussian tip suppression</li>
          <li>Validated against Blasius flat-plate analytical solution</li>
          <li>Integrated energy-expenditure model (thermal balance, mechanical power)</li>
          <li>Extracted wing-boundary from photographs for anatomically faithful meshes</li>
          <li>Currently: two-way FSI coupling and leaky-filament boundary conditions</li>
        </ul>
        <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-top:0.75rem;">
          <span class="card__tag">Firedrake</span>
          <span class="card__tag">PETSc</span>
          <span class="card__tag">Python</span>
          <span class="card__tag">Gmsh</span>
          <span class="card__tag">Slurm/HPC</span>
        </div>
      </div>

      <!-- Prosthetics -->
      <div class="timeline-item fade-in">
        <h3>Co-Lead, Myoelectric Mechanical Team</h3>
        <p class="meta">Accessible Prosthetics Initiative, UMD · Member Fall 2025, Co-Lead Fall 2026 – Present</p>
        <p>
          Leading a ~6-person mechanical subteam developing a myoelectric prosthetic hand
          that starts at the wrist. Coordinating with the electrical co-lead on motor
          control and EMG signal integration.
        </p>
        <ul style="padding-left:1.25rem; color:var(--text-secondary); line-height:1.7; font-size:0.95rem;">
          <li>Designed preliminary housing and two-joint thumb mechanism in SolidWorks</li>
          <li>Leading mechanical design decisions for the hand assembly</li>
          <li>Coordinating design reviews across mechanical and electrical subteams</li>
        </ul>
        <p style="font-size:0.85rem; color:var(--text-tertiary); font-style:italic; margin-top:0.5rem;">
          Note: Currently in the design phase — no working prototype yet.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-top:0.75rem;">
          <span class="card__tag">SolidWorks</span>
          <span class="card__tag">Team Leadership</span>
          <span class="card__tag">Mechanical Design</span>
        </div>
      </div>

      <!-- CAD visual -->
      <div class="fade-in" style="padding-left:1.75rem; padding-bottom:2rem; border-left:2px solid var(--border);">
        <div class="placeholder" style="min-height:200px;">
          <!-- Replace with: prosthetic hand CAD render -->
          <span>Prosthetic hand CAD render — SolidWorks screenshot (800×400)</span>
        </div>
      </div>

      <!-- Tutoring -->
      <div class="timeline-item fade-in">
        <h3>STEM Tutor</h3>
        <p class="meta">ClubZ In-Home Tutoring · May 2025 – Present · Bethesda, MD / Online</p>
        <p>
          One-on-one tutoring for undergraduate-level courses. Currently working with
          2 students across 3 courses.
        </p>
        <ul style="padding-left:1.25rem; color:var(--text-secondary); line-height:1.7; font-size:0.95rem;">
          <li>AP Physics 1</li>
          <li>Differential Equations</li>
          <li>Statics for Engineers</li>
        </ul>
        <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-top:0.75rem;">
          <span class="card__tag">Teaching</span>
          <span class="card__tag">Physics</span>
          <span class="card__tag">Engineering</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
