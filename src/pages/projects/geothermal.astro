---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Geothermal Heat Pump" description="Thermodynamic modeling of a year-round geothermal heat pump cycle." currentPage="/projects">
  <section style="padding:calc(var(--nav-height) + var(--space-12)) 0 var(--space-8);">
    <div class="container">
      <a href="/#projects" style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.1em;">← Back to projects</a>
      <span class="section-label" style="margin-top:var(--space-6);">Course Project · Thermodynamics</span>
      <h1 style="margin-top:var(--space-2);">Geothermal Heat Pump Design</h1>
      <p style="font-size:var(--text-lg); color:var(--text-secondary); max-width:640px; margin-top:var(--space-4);">
        Selected a refrigerant and modeled a year-round geothermal cycle in EES for a 12.3 kW thermal load.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="card card--featured reveal" data-reveal style="margin-bottom:var(--space-10);">
        <p style="margin-bottom:var(--space-2);"><strong>Course:</strong> Thermodynamics</p>
        <p style="margin-bottom:var(--space-2);"><strong>Type:</strong> Individual project</p>
        <p style="margin-bottom:0;"><strong>Tool:</strong> Engineering Equation Solver (EES)</p>
      </div>

      <img src="/images/placeholder.png" alt="Geothermal heat pump cycle diagram" style="width:100%; height:auto; border-radius:var(--radius-md); margin-bottom:var(--space-8); max-height:400px; object-fit:cover; border:1px solid var(--border);" />

      <div class="reveal" data-reveal>
        <h2>Problem</h2>
        <p>
          Design a geothermal heat pump system for both heating and cooling
          a 12.3 kW thermal load throughout the year. Select an appropriate refrigerant
          and model the full thermodynamic cycle.
        </p>

        <h2>Approach</h2>
        <p>
          Evaluated five candidate refrigerants. <strong>R-32</strong> was selected for
          its high COP, low GWP, and good volumetric capacity. The full vapor-compression
          cycle was modeled in <strong>EES</strong> with realistic component efficiencies.
        </p>

        <h2>Results</h2>
        <ul style="padding-left:var(--space-5); color:var(--text-secondary); line-height:1.8;">
          <li><strong>Heating COP:</strong> 4.30</li>
          <li><strong>Cooling COP:</strong> 1.83</li>
          <li><strong>Design load:</strong> 12.3 kW</li>
        </ul>

        <h2>Tools</h2>
        <div style="display:flex; flex-wrap:wrap; gap:var(--space-2); margin-top:var(--space-3);">
          <span class="chip">EES</span>
          <span class="chip">Thermodynamics</span>
          <span class="chip">Refrigerant Selection</span>
          <span class="chip">Energy Systems</span>
        </div>
      </div>

      <div style="margin-top:var(--space-12);">
        <a href="/#projects" class="btn btn--outline">← All Projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
