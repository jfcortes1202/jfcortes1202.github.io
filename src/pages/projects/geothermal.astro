---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import Carousel from '../../components/Carousel.astro';
import ReportViewer from '../../components/ReportViewer.astro';

const figures = [
  { src: '/media/geothermal/cycle-summer.webp', caption: 'System diagram, summer operation', alt: 'Schematic of the heat pump in summer mode: compressor, hot-water heater, condenser, throttle and evaporator with numbered states, connected to the underground loop' },
  { src: '/media/geothermal/cycle-winter.webp', caption: 'System diagram, winter operation', alt: 'Schematic of the heat pump in winter mode, with the condenser and evaporator roles reversed' },
  { src: '/media/geothermal/ts-summer.webp', caption: 'T-s diagram, R-32, summer', alt: 'Temperature–entropy diagram of the R-32 cycle in summer operation, with state points 1 to 5 on the saturation dome' },
  { src: '/media/geothermal/ts-winter.webp', caption: 'T-s diagram, R-32, winter', alt: 'Temperature–entropy diagram of the R-32 cycle in winter operation' },
];
---

<BaseLayout title="Geothermal Heat Pump Design" description="Thermodynamic modeling of a year-round geothermal heat pump cycle in EES for a 12.3 kW load.">
  <ProjectHeader
    kicker="Course project · Thermodynamics"
    title="Geothermal heat pump design"
    lead="Selected a refrigerant from five candidates and modeled a year-round geothermal cycle in EES for a 12.3 kW thermal load."
    facts={[
      { k: 'Course', v: 'Thermodynamics' },
      { k: 'Type', v: 'Team project' },
      { k: 'Tool', v: 'Engineering Equation Solver (EES)' },
      { k: 'Result', v: 'COP 4.30 heating / 1.83 cooling' },
    ]}
  />

  <section class="section">
    <div class="container--media">
      <Carousel id="geo-figures" label="Geothermal heat pump figures" slides={figures} thumbs />
    </div>

    <div class="container prose">
      <div data-reveal>
        <h2>Problem</h2>
        <p>
          Design a geothermal heat pump system that both heats and cools a 12.3 kW thermal
          load through the year. Select an appropriate refrigerant and model the full
          thermodynamic cycle.
        </p>

        <h2>Approach</h2>
        <p>
          We evaluated five candidate refrigerants and selected R-32 for its COP, low global
          warming potential, and volumetric capacity. The full vapor-compression cycle was
          modeled in EES with realistic component efficiencies, for both heating and cooling
          operation.
        </p>

        <h2>Results</h2>
        <ul>
          <li>Heating COP: 4.30</li>
          <li>Cooling COP: 1.83</li>
          <li>Design load: 12.3 kW</li>
        </ul>

        <h2>Report</h2>
        <p class="text-secondary">Refrigerant selection, cycle design, state tables, entropy and parametric studies.</p>
        <ReportViewer id="geothermal" title="Final design report" pdf="/docs/geothermal/final-report.pdf" size="1.8 MB" />

        <h2>Tools</h2>
        <ul class="chips">
          {['EES', 'Thermodynamics', 'Refrigerant selection', 'Energy systems'].map((t) => <li><span class="chip">{t}</span></li>)}
        </ul>
      </div>

      <div class="page-foot">
        <a href="/#projects" class="btn btn--outline">← All projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
