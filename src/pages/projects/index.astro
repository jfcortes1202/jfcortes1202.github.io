---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    title: "Computational FSI Simulation of Bat Flight",
    slug: "bat-wing-fsi",
    description: "Fluid-structure interaction modeling of bat flight with membrane perforations. Extended and validated an FSI codebase at UTSI.",
    tags: ["Firedrake", "PETSc", "FSI", "HPC", "Python"],
    flagship: true,
  },
  {
    title: "Wooden I-Beam Optimization",
    slug: "i-beam",
    description: "Derived stress and failure-load equations for an asymmetric pine I-beam, then built a Python optimizer to balance three failure modes within 20% of each other.",
    tags: ["Python", "Mechanics of Materials", "Team of 6"],
    flagship: false,
  },
  {
    title: "Geothermal Heat Pump Design",
    slug: "geothermal",
    description: "Selected R-32 from five candidate refrigerants and modeled a year-round geothermal cycle in EES for a 12.3 kW load — COP 4.30 heating, 1.83 cooling.",
    tags: ["EES", "Thermodynamics", "Individual"],
    flagship: false,
  },
  {
    title: "Over-Terrain Vehicle",
    slug: "otv",
    description: "Designed the magnetic-puck detection subsystem using a Faraday induction coil, then pivoted to a Hall-effect sensor. Co-wired the Arduino electronics.",
    tags: ["Arduino", "Electronics", "Team Project"],
    flagship: false,
  },
];
---

<BaseLayout title="Projects" description="Engineering projects — CFD simulation, structural optimization, thermodynamic modeling, and embedded systems." currentPage="/projects">
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">Projects</p>
      <h1 class="hero__title">Engineering Work</h1>
      <p class="hero__subtitle">
        Research and coursework projects spanning computational simulation,
        structural analysis, thermodynamics, and embedded systems.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container--wide">
      <div class="project-grid">
        {projects.map((p) => (
          <a href={`/projects/${p.slug}`} class={`card fade-in ${p.flagship ? 'card--flagship' : ''}`} style="text-decoration:none;">
            <img src="/images/placeholder.png" alt={`${p.title} thumbnail`} style="width:100%; height:160px; object-fit:cover; border-radius:var(--radius-sm); margin-bottom:1rem;" />
            {p.flagship && <span style="display:inline-block; font-size:0.7rem; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.5rem;">★ Flagship Research</span>}
            <h3 style="margin-top:0; color:var(--navy);">{p.title}</h3>
            <p style="color:var(--text-secondary); font-size:0.9rem;">{p.description}</p>
            <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-top:0.75rem;">
              {p.tags.map(tag => <span class="card__tag">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card--flagship {
    border: 1.5px solid var(--accent);
  }
</style>
