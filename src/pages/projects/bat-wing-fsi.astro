---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import Figure from '../../components/Figure.astro';
import Video from '../../components/Video.astro';

// Simulation clips in the order of the study: 2D → 3D sheet → bat wing → realistic injuries.
// Captions restate what each slide of the presentation shows; no results beyond the site text.
const gallery = [
  { src: '2d-flows', caption: '2D: slender filament in uniform flow (x-velocity)', label: 'Two-dimensional simulation of a slender filament flapping in a uniform flow, coloured by x-velocity' },
  { src: 'vorticity-re100-over-re1000', caption: '2D vorticity at Re = 100 (top) and Re = 1000 (bottom)', label: 'Two stacked 2D simulations comparing vorticity at Reynolds number 100 and 1000; the lower one sheds a periodic vortex street' },
  { src: 'flat-sheet', caption: '3D flat sheet in a channel flow, Re = 1000', label: 'Three-dimensional flat sheet oscillating in a channel flow, with velocity isosurfaces developing behind it' },
  { src: 'punctured-sheet', caption: 'Punctured sheet, hole radius 0.25, Re = 1000', label: 'Three-dimensional sheet with a circular hole oscillating in a channel flow, with velocity isosurfaces in its wake' },
  { src: 'punctured-sheet-vorticity', caption: 'Vorticity vectors on the punctured sheet', label: 'Vorticity vectors on the mesh of the punctured sheet, concentrated along the outer edge and around the hole' },
  { src: 'bat-wing-overview', caption: 'Bat-wing mesh with vorticity-magnitude contours, Re = 100', label: 'Triangulated bat-wing mesh with vorticity-magnitude contours concentrated along its edges' },
  { src: 'punctured-bat-wing', caption: 'Bat wing with an idealized perforation (r = 0.10), Re = 100', label: 'Flapping bat-wing mesh with a circular hole, with vorticity vectors around the edges and the hole' },
  { src: 'kinematics-mesh-and-wingtip', caption: 'Improved kinematics: bending wave plus flapping stroke, with the wingtip trajectory', label: 'Flapping bat-wing mesh beside a plot tracing the wingtip along an elliptical path' },
  { src: 'realistic-perforations', caption: 'Irregular, realistic perforations, Re = 1000', label: 'Bat-wing mesh with several irregular holes, flapping in the flow' },
];
---

<BaseLayout title="Computational FSI Simulation of Bat Flight" description="Fluid-structure interaction simulation of bat flight with membrane perforations, at the University of Tennessee Space Institute.">
  <ProjectHeader
    kicker="Primary research · University of Tennessee Space Institute"
    title="Computational FSI simulation of bat flight"
    lead="How wing-membrane perforations change aerodynamic performance, and how a bat's motion can adapt to them, simulated with fluid-structure interaction."
    backHref="/#research"
    backLabel="← Back to research"
    facts={[
      { k: 'Role', v: 'Research intern — extended and validated an existing FSI codebase' },
      { k: 'Advisor', v: 'Dr. Esteban Cisneros-Garibay, UTSI' },
      { k: 'Duration', v: 'June 2026 – present (remote during the semester)' },
      { k: 'Stack', v: 'Firedrake, PETSc, Python, Gmsh, VisIt, Slurm/HPC, Git' },
    ]}
  />

  <section class="section">
    <div class="container--media">
      <Video
        src="/media/research/video/injury-severity-2x2.mp4"
        label="Four bat-wing simulations side by side: an intact wing, holes of radius 0.10 and 0.15, and realistic irregular perforations, each with velocity isosurfaces in its wake"
        caption="Injury severity comparison: intact wing, holes of r = 0.10 and r = 0.15, and realistic perforations (Re = 1000)"
        paper
      />
    </div>

    <div class="container prose">
      <div data-reveal>
        <h2>Why injured bat flight</h2>
        <p>
          Bats are the only mammals capable of powered flight. Their wings are thin membranes,
          and membrane damage — tears and perforations — is common in wild populations, caused
          by injuries or by diseases. Despite that, little is known about how bats fly with
          damaged wings.
        </p>
        <p>
          The question has two halves. First, how do perforations of different sizes and
          locations affect aerodynamic performance? Second, how do the motion patterns a bat
          prefers reduce or mitigate that damage? Understanding how bats adapt their motion
          could inspire resilient, bio-inspired flight systems.
        </p>
      </div>

      <div data-reveal>
        <h2>What I did</h2>
        <ul>
          <li>Extended and validated an existing FSI codebase, progressing from a 2D flow model with a 1D filament to 3D flapping bat-wing models with membrane perforations</li>
          <li>Derived mathematical formulations and implemented them in the code</li>
          <li>Ran parametric studies</li>
          <li>Ran simulations on an HPC cluster</li>
          <li>Debugged mesh inversion in deforming geometries</li>
          <li>Fixed a one-sided traction integral to a two-sided formulation</li>
          <li>Implemented a Gaussian envelope for tip-oscillation suppression</li>
          <li>Validated the solver against the Blasius flat-plate analytical solution</li>
          <li>Integrated an energy-expenditure model</li>
          <li>Extracted the wing boundary from a bat photograph for anatomically faithful meshes</li>
        </ul>
      </div>

      <div data-reveal>
        <h2>Methods</h2>
        <h3>From 2D to 3D</h3>
        <p>
          The framework uses the finite element method through Firedrake, built on PETSc.
          Early work used a 2D flow field coupled with a 1D elastic filament to understand the
          coupling mechanics; from there the model was extended to 3D flapping bat-wing
          geometries with membrane perforations.
        </p>

        <h3>Mesh generation</h3>
        <p>
          Wing geometries are meshed in Gmsh. To make the models anatomically faithful, I
          extracted the wing-boundary coordinates directly from a bat photograph and used
          them to construct the computational mesh.
        </p>
        <Figure src="/media/research/bat-wing-mesh.webp" alt="Triangulated surface mesh of a bat wing, with the scalloped trailing edge between the finger bones" caption="Bat-wing surface mesh" paper />

        <h3>Numerics</h3>
        <p>
          Linear systems are solved with Krylov subspace methods (GMRES) and preconditioning,
          including algebraic multigrid where appropriate. Along the way I fixed a one-sided
          traction integral to a two-sided formulation for correct force coupling, added a
          Gaussian envelope to suppress non-physical oscillations at the wing tip, and
          debugged mesh inversion during large membrane deformations.
        </p>

        <h3>Validation</h3>
        <p>
          The solver was validated against the Blasius flat-plate solution, comparing
          computed velocity profiles with theory.
        </p>
        <MediaPlaceholder kind="Figure" label="Validation plot — computed vs. Blasius flat-plate solution" ratio="16 / 9" />

        <h3>Energy expenditure</h3>
        <p>
          Beyond the fluid-structure coupling, I integrated an energy-expenditure model so
          that the cost of flight can be compared across wing conditions and motion patterns.
        </p>
      </div>

      <div data-reveal>
        <h2>Current work</h2>
        <p>
          Implementing the elastic side of two-way FSI coupling and validating the approach.
        </p>
      </div>
    </div>

    <div class="container--media">
      <h2 style="margin-top:var(--space-12);">Simulation gallery</h2>
      <p class="text-secondary">The stages of the study in order, from a 2D filament to a bat wing with realistic injuries.</p>
      <div class="media-grid">
        {gallery.map((g) => (
          <Video src={`/media/research/video/${g.src}.mp4`} label={g.label} caption={g.caption} paper />
        ))}
      </div>
    </div>

    <div class="container prose">
      <div data-reveal>
        <h2>Presentation</h2>
        <div class="media-pair">
          <Figure src="/media/research/utsi-presentation.webp" alt="Juan at a podium presenting the title slide, 'Aerodynamics and Energy Expenditure of Injured Bat Flight', to an audience at UTSI" caption="Presenting the work at UTSI" />
          <div>
            <p>The 22-slide deck covers the formulation, each simulation stage, the energy model, and the parametric studies.</p>
            <div class="downloads">
              <a href="/cv/bat-flight-presentation.pdf" class="btn btn--primary" download>Download slides (PDF, 1.2 MB)</a>
              <a href="/cv/bat-flight-presentation.pdf" class="btn btn--outline" target="_blank" rel="noopener">Open in browser</a>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal>
        <h2>Tools</h2>
        <ul class="chips">
          {['Firedrake', 'PETSc', 'Python', 'Finite element method', 'Gmsh', 'VisIt', 'Slurm / HPC', 'Git / GitHub', 'GMRES / Krylov', 'LaTeX / Beamer'].map((t) => (
            <li><span class="chip">{t}</span></li>
          ))}
        </ul>
      </div>

      <div class="page-foot">
        <a href="/#research" class="btn btn--outline">← Back to research</a>
        <a href="/#projects" class="btn btn--outline">All projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
