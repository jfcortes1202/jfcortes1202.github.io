---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import Carousel from '../../components/Carousel.astro';
import ReportViewer from '../../components/ReportViewer.astro';

const photos = [
  { src: '/media/truss/finished.webp', caption: 'The finished truss, joints labeled A–L', alt: 'The wooden Howe truss lying flat, with colored glue dots at the joints and letter labels on each gusset' },
  { src: '/media/truss/testing.webp', caption: 'In the load frame', alt: 'The truss mounted in a materials testing machine before loading' },
];
const drawings = [
  { src: '/media/truss/drawing-assembly.webp', caption: 'Truss assembly', alt: 'Assembly drawing of the Howe truss with front, top, side and isometric views' },
  { src: '/media/truss/drawing-horizontal-members.webp', caption: 'Horizontal members', alt: 'Drawing of a horizontal member with dimensions' },
  { src: '/media/truss/drawing-vertical-members.webp', caption: 'Vertical members', alt: 'Drawing of a vertical member with dimensions' },
  { src: '/media/truss/drawing-diagonal-members.webp', caption: 'Diagonal members', alt: 'Drawing of a diagonal member with dimensions' },
  { src: '/media/truss/drawing-gussets.webp', caption: 'Gussets', alt: 'Drawing of a square gusset plate with dimensions' },
];
---

<BaseLayout title="Howe Truss" description="Hand analysis, SolidWorks drawings, and load testing of a white-oak Howe truss for ENES102.">
  <ProjectHeader
    kicker="Team project · ENES102"
    title="Howe truss: analysis, drawings, and load test"
    lead="Analyzed a white-oak Howe truss for its likeliest failure mode, drew it in SolidWorks, then built it and tested it to failure."
    facts={[
      { k: 'Course', v: 'ENES102' },
      { k: 'Team', v: 'Team 9, 3 members' },
      { k: 'My role', v: 'SolidWorks drawings; analysis and build with the team' },
      { k: 'Truss', v: 'Howe truss, 6 in tall, 0.375 × 0.75 in members' },
    ]}
  />

  <section class="section">
    <div class="container--media">
      <Carousel id="truss-photos" label="Photos of the truss" slides={photos} paper={false} ratio="3 / 2" />
    </div>

    <div class="container prose">
      <h2>Analysis</h2>
      <p>
        We checked three failure methods by hand: yielding in tension or compression, buckling
        of the members, and shear at the gussets. Comparing white and red oak, white oak needed
        more force to fail. With the method of joints, members EG and GI carry the highest force
        (0.95P), which put the critical point at joint G.
      </p>
      <p>
        Shear governed: the analysis predicted shear failure at joint G, on members EG or GI, at
        about 1.47 kips.
      </p>

      <h2>Test</h2>
      <p>
        The truss failed at joint G in shear — the location and mode we predicted — but at
        220 lb, well below the predicted load. Gluing the gussets was the main difficulty
        during the build, and we redesigned them partway through.
      </p>
      <h2>Hand calculations</h2>
      <ReportViewer id="truss" title="Truss analysis" pdf="/docs/truss/truss-analysis.pdf" size="4.2 MB" />
    </div>

    <div class="container--media">
      <h2>Drawings</h2>
      <p class="text-secondary">SolidWorks drawings of the assembly and each member type.</p>
      <Carousel id="truss-drawings" label="Truss drawings" slides={drawings} thumbs />
    </div>

    <div class="container prose">
      <h2>Tools</h2>
      <ul class="chips">
        {['Statics', 'Method of joints', 'Euler buckling', 'SolidWorks', 'Load testing'].map((t) => <li><span class="chip">{t}</span></li>)}
      </ul>

      <div class="page-foot">
        <a href="/#projects" class="btn btn--outline">← All projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
