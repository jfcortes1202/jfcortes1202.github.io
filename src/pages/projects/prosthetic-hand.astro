---
/**
 * Role page for the Accessible Prosthetics Initiative, mirroring the research page.
 * Content rule: several items are early-stage — frame them as ongoing work, and
 * never claim (or deny) a working prototype.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import Video from '../../components/Video.astro';
---

<BaseLayout title="Myoelectric Prosthetic Hand" description="Co-leading the mechanical subteam of UMD's Accessible Prosthetics Initiative, developing a myoelectric prosthetic hand.">
  <ProjectHeader
    kicker="Leadership · Accessible Prosthetics Initiative, UMD"
    title="Myoelectric prosthetic hand"
    lead="Co-leading the mechanical subteam developing a myoelectric prosthetic hand for people who have lost their hand from the wrist up."
    backHref="/#experience"
    backLabel="← Back to experience"
    facts={[
      { k: 'Role', v: 'Co-Lead, Myoelectric Mechanical Team' },
      { k: 'Team', v: '~6-person mechanical subteam' },
      { k: 'Timeline', v: 'Member Fall 2025, Co-Lead Fall 2026 – present' },
      { k: 'Tools', v: 'SolidWorks' },
    ]}
  />

  <section class="section">
    <div class="container prose">
      <div class="media-pair">
        <div>
          <h2 style="margin-top:0;">The project</h2>
          <p>
            UMD's Accessible Prosthetics Initiative is developing a myoelectric prosthetic hand
            for people who have lost their hand from the wrist up. The guiding constraint is
            that everything stays accessible and easy to assemble.
          </p>
          <p>
            I co-lead the mechanical subteam of about six people and coordinate with the
            electrical co-lead on motor control and EMG signal integration.
          </p>
        </div>
        <Video
          src="/media/prosthetics/hand-test.mp4"
          label="The prosthetics team at a workshop bench testing the hand: wired servos and electronics along the forearm, with team members adjusting it"
          caption="Bench test with the team"
          class="figure--portrait"
        />
      </div>

      <div data-reveal>
        <h2>What I've designed</h2>
        <ul>
          <li>The preliminary housing</li>
          <li>A two-joint thumb mechanism</li>
        </ul>

        <h2>What the team is working on</h2>
        <ul>
          <li>Improving the power transmission system and grip strength</li>
          <li>Iterating on new finger designs for better comfort</li>
          <li>Beginning to explore materials beyond PLA</li>
          <li>Starting to look into PCB design</li>
        </ul>
      </div>

      <div data-reveal>
        <h2>Tools</h2>
        <ul class="chips">
          {['SolidWorks', 'Team Leadership', 'Mechanical Design'].map((t) => <li><span class="chip">{t}</span></li>)}
        </ul>
      </div>

      <div class="page-foot">
        <a href="/#experience" class="btn btn--outline">← Back to experience</a>
        <a href="/#projects" class="btn btn--outline">All projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
