---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import Carousel from '../../components/Carousel.astro';

const figures = [
  { src: '/media/i-beam/cross-section.webp', caption: 'Final cross-section (inches)', alt: 'Dimensioned cross-section of the asymmetric I-beam: 1.5 in top flange, 1.0 in bottom flange, 0.3125 in web, 2.5 in web height' },
  { src: '/media/i-beam/drawing.webp', caption: 'Beam assembly drawing', alt: 'Engineering drawing of the beam with top, front and cross-section views' },
  { src: '/media/i-beam/shear-force.webp', caption: 'Shear force diagram', alt: 'Shear force diagram along the 20 in span, stepping from positive to negative at the 12 in load point' },
  { src: '/media/i-beam/bending-moment.webp', caption: 'Bending moment diagram', alt: 'Triangular bending moment diagram peaking at the 12 in load point' },
  { src: '/media/i-beam/deflection.webp', caption: 'Deflection curve (singularity functions)', alt: 'Beam deflection curve with the maximum deflection marked near 10.6 in from the left support' },
  { src: '/media/i-beam/after-test.webp', caption: 'The beam after testing', alt: 'The pine I-beam after load testing, with the top flange split' },
  { src: '/media/i-beam/after-test-section.webp', caption: 'Cross-section after testing', alt: 'End view of the tested beam standing on a table, showing the twisted web' },
];
---

<BaseLayout title="Wooden I-Beam Optimization" description="Stress analysis and optimization of an asymmetric wooden I-beam for ENES220, Mechanics of Materials.">
  <ProjectHeader
    kicker="Course project · ENES220 — Mechanics of Materials"
    title="Wooden I-beam design and optimization"
    lead="Derived failure-load equations for an asymmetric pine I-beam, then worked with a Python optimizer to balance three failure modes within 20% of each other."
    facts={[
      { k: 'Course', v: 'ENES220 — Mechanics of Materials' },
      { k: 'Team', v: '6 members' },
      { k: 'My role', v: 'Derived the governing equations; worked with a Python optimizer' },
      { k: 'Result', v: 'Three failure modes balanced within 20%' },
    ]}
  />

  <section class="section">
    <div class="container--media">
      <Carousel id="beam-figures" label="I-beam figures" slides={figures} thumbs />
    </div>

    <div class="container prose">
      <div data-reveal>
        <h2>Problem</h2>
        <p>
          Design an I-beam cross-section from pine lumber and wood glue that maximizes
          load-carrying capacity. The beam can fail three ways: flexural failure, wood shear
          failure, and glue-joint shear failure.
        </p>

        <h2>Approach</h2>
        <p>
          I derived the stress and failure-load equations for all three modes from first
          principles. The key idea: the best beam has all three failure loads as close to
          each other as possible, so no single mode is over-designed.
        </p>
        <p>
          I then worked with a Python optimizer that parameterized the cross-section
          dimensions and searched for a geometry where the three failure loads fell within
          20% of each other. The team built the beam and tested it to failure.
        </p>

        <h2>Report</h2>
        <p class="text-secondary">Derivations, optimization, deflection analysis, and test results.</p>
        <div class="downloads downloads--doc">
          <a href="/docs/i-beam/final-design-report.pdf" class="btn btn--outline" download>Final design report (PDF, 4.2 MB)</a>
        </div>

        <h2>Tools</h2>
        <ul class="chips">
          {['Python', 'Mechanics of Materials', 'Structural analysis', 'Lab testing'].map((t) => <li><span class="chip">{t}</span></li>)}
        </ul>
      </div>

      <div class="page-foot">
        <a href="/#projects" class="btn btn--outline">← All projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
