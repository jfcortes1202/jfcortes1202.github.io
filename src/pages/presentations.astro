---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Presentations" description="Talks and presentations on computational fluid dynamics research." currentPage="/presentations">
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">Presentations</p>
      <h1 class="hero__title">Talks &amp; Presentations</h1>
      <p class="hero__subtitle">
        Research presentations and technical talks.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <!-- Entry -->
      <div class="card fade-in" style="margin-bottom:1.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
          <div style="flex:1; min-width:280px;">
            <h3 style="margin-top:0; color:var(--navy);">
              Computational Fluid-Structure Interaction Simulation of Bat Flight
            </h3>
            <p style="color:var(--text-secondary); font-size:0.9rem; margin-bottom:0.5rem;">
              Final research talk — University of Tennessee Space Institute
            </p>
            <p style="color:var(--text-tertiary); font-size:0.85rem; margin-bottom:0.75rem;">
              Summer 2026
            </p>
            <p style="color:var(--text-secondary); font-size:0.95rem;">
              Presented research findings on FSI modeling of bat wings with membrane
              perforations, covering methodology, validation against the Blasius solution,
              and preliminary parametric results.
            </p>
            <div style="display:flex; gap:0.75rem; margin-top:1rem; flex-wrap:wrap;">
              <a href="/cv/bat-flight-presentation.pdf" class="btn btn--outline" style="font-size:0.85rem; padding:0.5rem 1rem;" download>
                Download Slides (PDF)
              </a>
            </div>
          </div>
          <div style="width:200px; flex-shrink:0;">
            <img src="/images/placeholder.png" alt="Bat flight presentation slide" style="width:100%; height:130px; object-fit:cover; border-radius:var(--radius-sm);" />
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
