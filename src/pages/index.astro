      <!-- Side projects mention -->
      <div class="reveal" data-reveal style="margin-top:var(--space-8); text-align:center;">
        <p style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.1em;">
          Side experiments: ASCII torus animation · Roblox game development
        </p>
      </div>
