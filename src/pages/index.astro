      </div>

      <!-- Tutoring -->
      <div class="timeline-item reveal" data-reveal>
        <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:var(--space-2);">
          <h3 style="margin-top:0;">STEM Tutor</h3>
          <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:#22C55E;">teaching</span>
        </div>
        <p class="meta">ClubZ In-Home Tutoring · May 2025 – Present · Bethesda, MD / Online</p>
        <p style="font-size:var(--text-sm); color:var(--text-secondary);">
          One-on-one tutoring for undergraduate-level courses. Currently working with
          2 students across AP Physics 1, Differential Equations, and Statics for Engineers.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════ PROJECTS ═══════════ -->
  <section class="section" id="projects">
    <div class="container--wide">
      <div class="divider">
        <span class="divider__tick">04 / Projects</span>
      </div>
      <h2 style="margin-top:0;">Engineering Work</h2>
      <p style="color:var(--text-secondary); max-width:600px;">
        Research and coursework projects spanning computational simulation,
        structural analysis, thermodynamics, and embedded systems.
      </p>

      <div class="project-grid">
        {projects.map((p) => (
          <a href={`/projects/${p.slug}`} class={`card reveal ${p.flagship ? 'card--featured' : ''}`} data-reveal>
            <img src="/images/placeholder.png" alt={`${p.title} thumbnail`} style="width:100%; height:160px; object-fit:cover; border-radius:var(--radius-sm); margin-bottom:var(--space-4);" />
            {p.flagship && <span class="chip" style="margin-bottom:var(--space-3);">★ Flagship Research</span>}
            <h3 style="margin-top:0; font-size:var(--text-lg);">{p.title}</h3>
            <p style="color:var(--text-secondary); font-size:var(--text-sm);">{p.description}</p>
            <p style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--accent); margin-top:var(--space-3); margin-bottom:var(--space-3);">
