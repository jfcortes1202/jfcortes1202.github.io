---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: "Computational FSI Simulation of Bat Flight",
    slug: "bat-wing-fsi",
    description: "Extended and validated an FSI codebase at UTSI, progressing from 2D flow to 3D flapping bat-wing models with membrane perforations.",
    tags: ["Firedrake", "PETSc", "FSI", "HPC", "Python"],
    flagship: true,
    outcome: "3D model with anatomically faithful wing geometry",
  },
  {
    title: "Wooden I-Beam Optimization",
    slug: "i-beam",
    description: "Derived stress and failure-load equations for an asymmetric pine I-beam, then built a Python optimizer to balance three failure modes within 20% of each other.",
    tags: ["Python", "Mechanics of Materials", "Team of 6"],
    flagship: false,
    outcome: "Three failure modes balanced within 20%",
  },
  {
    title: "Geothermal Heat Pump Design",
    slug: "geothermal",
    description: "Selected R-32 from five candidates and modeled a year-round geothermal cycle in EES for a 12.3 kW load.",
    tags: ["EES", "Thermodynamics", "Individual"],
    flagship: false,
    outcome: "COP 4.30 heating / 1.83 cooling",
  },
  {
    title: "Over-Terrain Vehicle",
    slug: "otv",
    description: "Designed the magnetic-puck detection subsystem using Faraday induction, then pivoted to a Hall-effect sensor. Co-wired the Arduino electronics.",
    tags: ["Arduino", "Electronics", "Team Project"],
    flagship: false,
    outcome: "Working detection subsystem with Hall-effect sensor",
  },
];
---

<BaseLayout title="Home" currentPage="/">

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero" id="hero">
    <div class="hero__canvas" id="heroCanvas" aria-hidden="true"></div>
    <div class="hero__glow"></div>
    <div class="hero__content">
      <p class="hero__eyebrow">Mechanical Engineering · Physics · CFD Research</p>
      <h1 class="hero__name">Juan Cortés</h1>
      <p class="hero__tagline">
        Undergraduate researcher in computational fluid dynamics.
        Double-majoring at the University of Maryland. Building simulations
        that bridge biology and aerospace.
      </p>
      <div class="hero__actions">
        <a href="#research" class="btn btn--primary">View My Work</a>
        <a href="#contact" class="btn btn--outline" style="color:var(--slate-300); border-color:var(--slate-600);">Get in Touch</a>
      </div>
      <div class="hero__social">
        <a href="https://github.com/jfcortes1202" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://linkedin.com/in/jcortes2" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="mailto:juanfelipecortes1202@gmail.com">Email ↗</a>
        <a href="/cv/resume.pdf" download>Resume ↓</a>
      </div>
    </div>
  </section>

  <!-- Currently strip -->
  <div class="currently">
    <div class="currently__inner">
      <span class="currently__label">
        <span class="currently__dot"></span>
        Currently
      </span>
      <div class="currently__items">
        <span class="currently__item">Bat-flight FSI research at UTSI</span>
        <span class="currently__item">Prosthetic hand co-lead</span>
        <span class="currently__item">Dynamics &amp; Quantum II</span>
      </div>
    </div>
  </div>

  <!-- ═══════════ STATS ═══════════ -->
  <div class="stats">
    <div class="stats__grid">
      <div class="stats__item">
        <span class="stats__number">3.97</span>
        <span class="stats__label">GPA / 4.00</span>
      </div>
      <div class="stats__item">
        <span class="stats__number">Dean's</span>
        <span class="stats__label">List every semester</span>
      </div>
      <div class="stats__item">
        <span class="stats__number">42</span>
        <span class="stats__label">AP credits</span>
      </div>
      <div class="stats__item">
        <span class="stats__number">~6</span>
        <span class="stats__label">Team members led</span>
      </div>
    </div>
  </div>

  <!-- ═══════════ ABOUT ═══════════ -->
  <section class="section section--grid" id="about">
    <div class="container--wide">
      <div class="divider">
        <span class="divider__tick">01 / About</span>
      </div>
      <div style="display:grid; grid-template-columns:1fr 300px; gap:var(--space-10); align-items:start;" class="about-layout">
        <div class="reveal" data-reveal>
          <h2 style="margin-top:0;">A little about me</h2>
          <p>
            I'm a junior at the University of Maryland, College Park, double-majoring
            in Mechanical Engineering and Physics. My research sits at the intersection
            of computational fluid dynamics, aerospace engineering, and applied mathematics —
            I'm currently working on fluid-structure interaction simulations of bat flight
            at the University of Tennessee Space Institute.
          </p>
          <p>
            Beyond research, I co-lead the mechanical subteam of UMD's Accessible Prosthetics
            Initiative, where we're developing a myoelectric prosthetic hand. I also tutor
            undergraduate students in physics and engineering courses.
          </p>
          <p style="color:var(--text-secondary);">
            Long-term, I'm aiming for a career in defense and aerospace engineering, with a
            master's degree planned. I'm driven by curiosity — whether it's modeling turbulent
            flows, understanding quantum mechanics, or designing mechanisms that solve real
            problems.
          </p>
          <div style="display:flex; gap:var(--space-8); margin-top:var(--space-6); flex-wrap:wrap;">
            <div>
              <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.1em;">Focus</span>
              <p style="margin:var(--space-1) 0 0; font-weight:600; color:var(--text-heading);">Defense &amp; Aerospace</p>
            </div>
            <div>
              <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.1em;">Graduation</span>
              <p style="margin:var(--space-1) 0 0; font-weight:600; color:var(--text-heading);">May 2028</p>
            </div>
            <div>
              <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.1em;">Looking for</span>
              <p style="margin:var(--space-1) 0 0; font-weight:600; color:var(--text-heading);">Summer 2027 internships</p>
            </div>
          </div>
        </div>
        <div class="reveal" data-reveal>
          <img src="/images/placeholder.png" alt="Juan Cortés headshot" class="about-photo" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ RESEARCH SPOTLIGHT ═══════════ -->
  <section class="section" id="research">
    <div class="container--wide">
      <div class="divider">
        <span class="divider__tick">02 / Research</span>
      </div>
      <div class="reveal" data-reveal>
        <div class="card card--featured" style="padding:var(--space-8);">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-8); align-items:start;" class="research-layout">
            <div>
              <span class="chip" style="margin-bottom:var(--space-4);">★ Flagship Research</span>
              <h2 style="margin-top:var(--space-2);">Computational FSI Simulation of Bat Flight</h2>
              <p style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-tertiary); margin-bottom:var(--space-4);">
                UTSI · Advisor: Dr. Esteban Cisneros-Garibay · June 2026 – present
              </p>
              <p>
                Bat wings are thin membranes that can sustain tears and perforations from encounters
                with obstacles, predators, or disease. My work uses computational fluid-structure
                interaction to simulate how these holes affect aerodynamic performance.
              </p>
              <p style="color:var(--text-secondary);">
                I extended and validated an existing FSI codebase, moving from a 2D flow model
                coupled with a 1D filament to full 3D flapping bat-wing models with membrane
                perforations.
              </p>

              <h3 style="font-size:var(--text-base); margin-top:var(--space-6);">What I Did</h3>
              <ul style="padding-left:var(--space-5); color:var(--text-secondary); line-height:1.8; font-size:var(--text-sm);">
                <li>Progressed from 2D flow + 1D filament to 3D flapping bat-wing with perforations</li>
                <li>Debugged mesh inversion in deforming geometries</li>
                <li>Fixed one-sided traction integral to two-sided formulation</li>
                <li>Implemented Gaussian envelope for tip oscillation suppression</li>
                <li>Validated solver against Blasius flat-plate analytical solution</li>
                <li>Integrated energy-expenditure model (thermal balance, mechanical power)</li>
                <li>Extracted wing-boundary from bat photograph for anatomically faithful meshes</li>
              </ul>
            </div>
            <div>
              <img src="/images/placeholder.png" alt="Bat-wing FSI simulation visualization" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--radius-md); margin-bottom:var(--space-6); border:1px solid var(--border);" />

              <h3 style="font-size:var(--text-base);">Current Work</h3>
              <p style="font-size:var(--text-sm); color:var(--text-secondary);">
                Two-way FSI coupling and leaky-filament boundary conditions to model
                injured wings with varying perforation sizes and locations.
              </p>

              <h3 style="font-size:var(--text-base); margin-top:var(--space-6);">Tech Stack</h3>
              <div style="display:flex; flex-wrap:wrap; gap:var(--space-2); margin-top:var(--space-2);">
                <span class="chip">Firedrake</span>
                <span class="chip">PETSc</span>
                <span class="chip">Python</span>
                <span class="chip">Gmsh</span>
                <span class="chip">VisIt</span>
                <span class="chip">Slurm / HPC</span>
                <span class="chip">Git / GitHub</span>
                <span class="chip">LaTeX / Beamer</span>
              </div>

              <div style="margin-top:var(--space-6);">
                <h3 style="font-size:var(--text-base);">Timeline</h3>
                <div style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-secondary); line-height:2;">
                  <div>2D flow + 1D filament → validation</div>
                  <div>Blasius flat-plate benchmark ✓</div>
                  <div>3D wing geometry from photograph</div>
                  <div>Energy model integration</div>
                  <div style="color:var(--accent);">→ Two-way FSI + perforations (current)</div>
                </div>
              </div>
            </div>
          </div>
          <div style="margin-top:var(--space-6);">
            <a href="/projects/bat-wing-fsi" class="btn btn--primary" style="font-size:var(--text-sm);">View Full Project Detail →</a>
            <a href="/cv/bat-flight-presentation.pdf" class="btn btn--outline" style="font-size:var(--text-sm); margin-left:var(--space-3);" download>Download Slides (PDF)</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ EXPERIENCE ═══════════ -->
  <section class="section section--alt section--grid" id="experience">
    <div class="container">
      <div class="divider">
        <span class="divider__tick">03 / Experience</span>
      </div>
      <h2 style="margin-top:0;">Research, Leadership &amp; Teaching</h2>

      <!-- UTSI -->
      <div class="timeline-item reveal" data-reveal>
        <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:var(--space-2);">
          <h3 style="margin-top:0;">Research Intern</h3>
          <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--accent);">research</span>
