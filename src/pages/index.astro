<script>
  // ─── Animated streamline hero canvas ───
  (function() {
    const container = document.getElementById('heroCanvas');
    if (!container) return;

    // Respect reduced motion
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const canvas = document.createElement('canvas');
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    container.appendChild(canvas);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w: number, h: number;
    let particles: Array<{x:number; y:number; vx:number; vy:number; life:number; maxLife:number; speed:number}> = [];
    let animFrame: number;
    let isVisible = true;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = container!.clientWidth;
      h = container!.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Simple NACA-ish airfoil shape for flow field influence
    const airfoilCx = 0.55; // center x ratio
    const airfoilCy = 0.5;  // center y ratio
    const airfoilLen = 0.25; // length ratio

    function flowField(px: number, py: number): [number, number] {
      const cx = w * airfoilCx;
      const cy = h * airfoilCy;
      const len = w * airfoilLen;

      const dx = px - cx;
      const dy = py - cy;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const influence = Math.max(0, 1 - dist / (len * 1.8));

      // Base flow: left to right with slight curve
      let vx = 1.2;
      let vy = 0.1 * Math.sin(px / w * Math.PI);

      // Near the airfoil: deflect particles around it
      if (influence > 0) {
        const angle = Math.atan2(dy, dx);
        const deflect = influence * 2;
        vx += Math.cos(angle + Math.PI / 2) * deflect * 0.5;
        vy += Math.sin(angle + Math.PI / 2) * deflect;
      }

      return [vx, vy];
    }

    function spawnParticle() {
      const speed = 0.4 + Math.random() * 0.8;
      return {
        x: -10 + Math.random() * 20,
        y: Math.random() * h,
        vx: 0,
        vy: 0,
        life: 0,
        maxLife: 200 + Math.random() * 300,
        speed,
      };
    }

    function init() {
      resize();
      particles = [];
      const count = Math.min(Math.floor(w * h / 4000), 150);
      for (let i = 0; i < count; i++) {
        const p = spawnParticle();
        p.x = Math.random() * w;
        p.life = Math.random() * p.maxLife;
        particles.push(p);
      }
    }

    function draw() {
      if (!ctx || !isVisible) return;

      ctx.clearRect(0, 0, w, h);

      // Draw faint airfoil silhouette
      const cx = w * airfoilCx;
      const cy = h * airfoilCy;
      const len = w * airfoilLen;

      ctx.beginPath();
      ctx.ellipse(cx, cy, len * 0.5, len * 0.08, 0, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(96, 165, 250, 0.04)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(96, 165, 250, 0.08)';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const [fx, fy] = flowField(p.x, p.y);
        p.vx = p.vx * 0.95 + fx * 0.05;
        p.vy = p.vy * 0.95 + fy * 0.05;
        p.x += p.vx * p.speed;
        p.y += p.vy * p.speed;
        p.life++;

        const fade = Math.min(p.life / 40, 1) * Math.max(0, 1 - p.life / p.maxLife);
        const alpha = fade * 0.5;

        if (alpha > 0.01) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, 1.2, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(96, 165, 250, ${alpha})`;
          ctx.fill();

          // Trail
          const tx = p.x - p.vx * p.speed * 4;
          const ty = p.y - p.vy * p.speed * 4;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(tx, ty);
          ctx.strokeStyle = `rgba(96, 165, 250, ${alpha * 0.3})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }

        if (p.life > p.maxLife || p.x > w + 20 || p.y < -20 || p.y > h + 20) {
          particles[i] = spawnParticle();
        }
      }

      if (!prefersReduced) {
        animFrame = requestAnimationFrame(draw);
      }
    }

    // Visibility observer — pause when off screen
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible && !prefersReduced) {
        cancelAnimationFrame(animFrame);
        animFrame = requestAnimationFrame(draw);
      }
    }, { threshold: 0.1 });
    observer.observe(container);

    window.addEventListener('resize', () => {
      resize();
    });

    init();

    if (prefersReduced) {
      // Draw one static frame
      draw();
    } else {
      animFrame = requestAnimationFrame(draw);
    }
  })();
</script>
