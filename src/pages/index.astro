---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import Figure from '../components/Figure.astro';
import Video from '../components/Video.astro';

// `fit: 'contain'` for CAD renders and plots (show the whole drawing), `cover` for photos.
const projects = [
  {
    title: 'Articulated Robotic Arm',
    slug: 'robotic-arm',
    course: 'ENME272 · Computer Aided Design · Team of 3',
    description:
      'Modeled a 26-part alloy-steel robotic arm in SolidWorks: base and gripper sub-assemblies, full drawings and BOM, a motion study, and static FEA on the support.',
    outcome: 'FEA: 0.0033 mm max displacement on the support',
    image: '/media/robotic-arm/assembly/assembly.webp',
    alt: 'SolidWorks render of the articulated robotic arm on its square base frame',
    fit: 'contain',
  },
  {
    title: 'Wooden I-Beam Optimization',
    slug: 'i-beam',
    course: 'ENES220 · Mechanics of Materials · Team of 6',
    description:
      'Derived stress and failure-load equations for an asymmetric pine I-beam, then worked with a Python optimizer to balance three failure modes within 20% of each other.',
    outcome: 'Three failure modes balanced within 20%',
    image: '/media/i-beam/after-test.webp',
    alt: 'The pine I-beam after load testing, with the top flange cracked',
    fit: 'cover',
  },
  {
    title: 'Geothermal Heat Pump Design',
    slug: 'geothermal',
    course: 'Thermodynamics · Team project',
    description:
      'Selected R-32 from five candidate refrigerants and modeled a year-round geothermal cycle in EES for a 12.3 kW load.',
    outcome: 'COP 4.30 heating / 1.83 cooling',
    image: '/media/geothermal/ts-summer.webp',
    alt: 'Temperature–entropy diagram of the R-32 cycle in summer operation',
    fit: 'contain',
  },
  {
    title: 'Over-Terrain Vehicle',
    slug: 'otv',
    course: 'ENES100 · Intro to Engineering Design · Team project',
    description:
      'Designed the magnetic-puck detection subsystem using Faraday induction, then pivoted to a Hall-effect sensor. Co-wired the Arduino electronics.',
    outcome: 'Faraday coil modeled, iterated to Hall-effect sensor',
    image: '/media/otv/prototype-cad.webp',
    alt: 'CAD render of the over-terrain vehicle: plexiglass chassis on four wooden legs with the mission mechanism in the centre',
    fit: 'contain',
  },
  {
    title: '3D-Printed Phone Stand',
    slug: 'phone-stand',
    course: 'ENME272 · Computer Aided Design · Individual',
    description:
      'Designed a lightweight PLA phone stand in SolidWorks, checked it with static FEA, and printed it.',
    outcome: 'Peak stress 1.69 MPa vs. PLA yield of 26–53 MPa',
    image: '/media/phone-stand/render-iso.webp',
    alt: 'SolidWorks render of the phone stand: a perforated base and triangular truss back',
    fit: 'contain',
  },
  {
    title: 'Howe Truss',
    slug: 'truss',
    course: 'ENES102 · Team of 3',
    description:
      'Analyzed a white-oak Howe truss by hand for yielding, buckling, and gusset shear, drew it in SolidWorks, then built and load-tested it.',
    outcome: 'Failed in shear at joint G: predicted mode and location',
    image: '/media/truss/finished.webp',
    alt: 'The finished wooden Howe truss with labeled joints, lying flat before testing',
    fit: 'cover',
  },
];

const skills = [
  { title: 'Simulation & Numerical Methods', items: ['Firedrake & PETSc (FEM)', 'Fluid-structure interaction', 'Gmsh · VisIt · EES', 'Krylov methods / GMRES / AMG'] },
  { title: 'Programming', items: ['Python', 'MATLAB', 'LaTeX / Beamer', 'Git / GitHub'] },
  { title: 'CAD & Design', items: ['SolidWorks', 'Fusion 360', 'Parts / assemblies / drawings', 'Static FEA'] },
  { title: 'HPC & Computing', items: ['HPC with Slurm', 'Linux CLI', 'Remote development'] },
  { title: 'Hardware & Lab', items: ['Arduino', 'Breadboarding', 'Oscilloscope & multimeter'] },
  { title: 'Communication', items: ['Technical writing', 'Research presentations', 'Overleaf / Excel'] },
];
const languages = [
  { name: 'Spanish', level: 'Native' },
  { name: 'English', level: 'Fluent · C2, IELTS' },
  { name: 'German', level: 'Intermediate · B1, Goethe-Institut' },
];

const completed = ['Multivariable Calculus', 'Linear Algebra', 'Diff Eq I–II (Honors)', 'Mechanics I–II', 'Thermodynamics', 'Intro to CAD', 'Computational Fundamentals', 'E&M I–II', 'Modern Physics', 'Quantum Physics I', 'Experimental Physics I', 'Technical Writing'];
const inProgress = ['Dynamics', 'Classical Mechanics', 'Quantum Physics II', 'Electronics & Instrumentation I', 'Experimental Physics III', 'Statistical Methods'];

const awards = [
  { name: 'Professor William M. MacDonald Physics Endowed Scholarship', note: '' },
  { name: 'CMNS Undergraduate Scholarship Fund', note: 'received twice' },
  { name: 'Maria and Michael Korsnick Nuclear Engineering Innovation Award', note: '' },
  { name: 'Angelo Bardasis Fellowship', note: '' },
];
---

<BaseLayout title="Juan Cortés">

  <!-- ═══════════ HERO (always dark) ═══════════ -->
  <section class="hero" id="hero" aria-labelledby="hero-name">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">Mechanical Engineering · Physics</p>
        <h1 class="hero__name" id="hero-name">Juan Cortés</h1>
        <p class="hero__tagline">
          Undergraduate researcher in computational fluid dynamics and mechanical design.
          Double-majoring at the University of Maryland. Interested in aerospace, defense,
          automotive, and energy systems.
        </p>
        <div class="hero__actions">
          <a href="#research" class="btn btn--primary">View My Work</a>
          <a href="#contact" class="btn btn--outline">Get in Touch</a>
        </div>
        <ul class="hero__social" aria-label="Links">
          <li><a href="https://github.com/jfcortes1202" target="_blank" rel="noopener">GitHub ↗</a></li>
          <li><a href="https://linkedin.com/in/jcortes2" target="_blank" rel="noopener">LinkedIn ↗</a></li>
          <li><a href="mailto:juanfelipecortes1202@gmail.com">Email ↗</a></li>
          <li><a href="/cv/resume.pdf" download>Resume ↓</a></li>
        </ul>
      </div>
      <figure class="hero__figure">
        <HeroIllustration />
        <figcaption class="hero__figcaption">
          <span>Fig. 01 — gas turbine engine, section view</span>
          <span>not to scale</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══════════ 01 ABOUT ═══════════ -->
  <section class="section section--grid" id="about" aria-labelledby="about-title">
    <div class="container--wide">
      <div class="divider"><span class="divider__tick">01 / About</span></div>
      <div class="two-col">
        <div data-reveal>
          <h2 id="about-title" class="section-title">A little about me</h2>
          <p>
            I'm a junior at the University of Maryland, College Park, double-majoring in
            Mechanical Engineering and Physics. This past summer I joined the University of
            Tennessee Space Institute as a research intern, working on computational
            fluid-structure interaction simulations of bat flight, and I'm continuing that
            work remotely from Maryland during the semester. It combines CFD and applied
            mathematics with a biological question I find hard to put down.
          </p>
          <p>
            On campus I co-lead the mechanical subteam of UMD's Accessible Prosthetics
            Initiative, where we're developing a myoelectric prosthetic hand for people who
            have lost their hand from the wrist up. I also tutor students in AP Physics 1,
            Differential Equations, and Statics for Engineers.
          </p>
          <p class="text-secondary">
            What ties it together is curiosity. I like problems where the physics is subtle
            and the engineering has to be exact, whether that's a wing membrane, a
            tendon-driven finger, or a heat pump cycle. I'm planning on a master's degree and
            keeping the domain open: aerospace, defense, automotive, energy, and computational
            modeling all pull at me.
          </p>
        </div>
        <div data-reveal>
          <Figure src="/media/about/headshot.webp" alt="Juan Cortés in a black tuxedo and bow tie, smiling, with the Washington Monument behind him" class="about-photo" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 02 RESEARCH ═══════════ -->
  <section class="section" id="research" aria-labelledby="research-title">
    <div class="container--wide">
      <div class="divider"><span class="divider__tick">02 / Research</span></div>
      <article class="research" data-reveal>
        <div class="research__main">
          <p class="research__kicker">Primary research · University of Tennessee Space Institute</p>
          <h2 id="research-title" class="research__title">Computational FSI simulation of bat flight</h2>
          <p class="meta">Advisor: Dr. Esteban Cisneros-Garibay · UTSI · June 2026 – present</p>
          <p>
            Bats are the only mammals capable of powered flight, and their wings are thin
            membranes that tear and perforate easily, from injuries or from disease. Damaged
            wings are common in wild populations, yet little is known about how bats keep
            flying with them.
          </p>
          <p>
            This work simulates not only how perforations degrade aerodynamic performance,
            but how a bat's preferred motion patterns can reduce or mitigate that damage for
            more effective flight. Understanding that adaptation could inform resilient,
            bio-inspired flight systems.
          </p>

          <h3>What I did</h3>
          <ul class="research__list">
            <li>Extended and validated an existing FSI codebase, progressing from 2D flow + 1D filament to 3D flapping bat-wing models with membrane perforations</li>
            <li>Derived mathematical formulations and implemented them in the code</li>
            <li>Ran parametric studies and simulations on an HPC cluster</li>
            <li>Debugged mesh inversion in deforming geometries</li>
            <li>Fixed a one-sided traction integral to a two-sided formulation</li>
            <li>Implemented a Gaussian envelope for tip-oscillation suppression</li>
            <li>Validated the solver against the Blasius flat-plate analytical solution</li>
            <li>Integrated an energy-expenditure model</li>
            <li>Extracted the wing boundary from a bat photograph for anatomically faithful meshes</li>
          </ul>

          <h3>Current work</h3>
          <p class="text-secondary">
            Implementing the elastic side of two-way FSI coupling and validating the approach.
          </p>

          <div class="research__actions">
            <a href="/projects/bat-wing-fsi" class="btn btn--primary">View full project detail →</a>
            <a href="/cv/bat-flight-presentation.pdf" class="btn btn--outline" download>Download slides (PDF)</a>
          </div>
        </div>

        <aside class="research__aside">
          <Video
            src="/media/research/video/punctured-bat-wing.mp4"
            label="Simulation of a flapping bat wing with a circular membrane perforation, showing vorticity vectors around the wing edge and the hole"
            caption="Flapping bat wing with a perforation (r = 0.10), Re = 100"
            paper
          />
          <h4 style="margin-top:var(--space-6);">Tools</h4>
          <ul class="chips">
            {['Firedrake', 'PETSc', 'Python', 'Gmsh', 'VisIt', 'Slurm / HPC', 'Git / GitHub', 'LaTeX / Beamer'].map((t) => (
              <li><span class="chip">{t}</span></li>
            ))}
          </ul>
        </aside>
      </article>
    </div>
  </section>

  <!-- ═══════════ 03 EXPERIENCE ═══════════ -->
  <section class="section section--alt section--grid" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <div class="divider"><span class="divider__tick">03 / Experience</span></div>
      <h2 id="experience-title" class="section-title">Research, leadership &amp; teaching</h2>
      <p class="section-intro text-secondary">What I'm working on now, and where.</p>

      <div class="timeline">
        <div class="timeline__track" aria-hidden="true"></div>
        <div class="timeline__rail" aria-hidden="true"></div>

        <article class="timeline-item" data-reveal>
          <div class="timeline-item__head">
            <h3>Research Intern</h3>
            <span class="role-tag role-tag--research">research</span>
          </div>
          <p class="meta">University of Tennessee Space Institute · June 2026 – Present · Remote</p>
          <p>
            Working under Dr. Esteban Cisneros-Garibay on computational FSI simulation of bat
            flight. Extended and validated an existing FSI codebase, progressing from 2D flow
            models to full 3D flapping bat-wing simulations with membrane perforations.
          </p>
          <ul class="chips">
            {['Firedrake', 'PETSc', 'Python', 'Gmsh', 'Slurm / HPC'].map((t) => <li><span class="chip">{t}</span></li>)}
          </ul>
          <a href="/projects/bat-wing-fsi" class="timeline-item__link">Research details →</a>
        </article>

        <article class="timeline-item" data-reveal>
          <div class="timeline-item__head">
            <h3>Co-Lead, Myoelectric Mechanical Team</h3>
            <span class="role-tag role-tag--leadership">leadership</span>
          </div>
          <p class="meta">Accessible Prosthetics Initiative, UMD · Member Fall 2025, Co-Lead Fall 2026 – Present</p>
          <p>
            Leading a ~6-person mechanical subteam developing a myoelectric prosthetic hand for
            people who have lost their hand from the wrist up, with the constraint that
            everything stays accessible and easy to assemble.
          </p>
          <ul>
            <li>Working on the power transmission system and grip strength</li>
            <li>Iterating on new finger designs for better comfort</li>
            <li>Beginning to explore materials beyond PLA and in-house PCB design</li>
            <li>Coordinating with the electrical co-lead on motor control and EMG signal integration</li>
            <li>Designed the preliminary housing and a two-joint thumb mechanism</li>
          </ul>
          <ul class="chips">
            {['SolidWorks', 'Team Leadership', 'Mechanical Design'].map((t) => <li><span class="chip">{t}</span></li>)}
          </ul>
          <a href="/projects/prosthetic-hand" class="timeline-item__link">Role details →</a>
        </article>

        <article class="timeline-item" data-reveal>
          <div class="timeline-item__head">
            <h3>STEM Tutor</h3>
            <span class="role-tag role-tag--teaching">teaching</span>
          </div>
          <p class="meta">ClubZ In-Home Tutoring · May 2025 – Present · Bethesda, MD / Online</p>
          <p>
            One-on-one STEM tutoring across AP Physics 1, Differential Equations, and Statics
            for Engineers. Currently working with two students.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════ 04 PROJECTS ═══════════ -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container--wide">
      <div class="divider"><span class="divider__tick">04 / Projects</span></div>
      <h2 id="projects-title" class="section-title">Engineering work</h2>
      <p class="section-intro text-secondary">
        Course and team projects in CAD, structural analysis, thermodynamics, and embedded systems.
      </p>
      <div class="project-grid" data-reveal-group>
        {projects.map((p) => (
          <a href={`/projects/${p.slug}`} class="project-tile">
            <div class:list={['project-tile__media', { 'project-tile__media--contain': p.fit === 'contain' }]}>
              <img src={p.image} alt={p.alt} width="800" height="600" loading="lazy" decoding="async" />
            </div>
            <p class="project-tile__course">{p.course}</p>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            <p class="project-tile__result">Result: {p.outcome}</p>
            <span class="project-tile__link">Project details →</span>
          </a>
        ))}
      </div>
      <a href="/projects/cad-coursework" class="more-cad" data-reveal>
        <span class="more-cad__title">More CAD: ENME272 coursework</span>
        <span class="more-cad__body">41 parts and assemblies, engineering drawings, and FEA studies in SolidWorks and Inventor.</span>
        <span class="more-cad__link">View coursework →</span>
      </a>
    </div>
  </section>

  <!-- ═══════════ 05 SKILLS ═══════════ -->
  <section class="section section--alt section--grid" id="skills" aria-labelledby="skills-title">
    <div class="container--wide">
      <div class="divider"><span class="divider__tick">05 / Skills</span></div>
      <h2 id="skills-title" class="section-title">Technical skills</h2>
      <p class="section-intro text-secondary">Tools I use regularly, grouped by what they're for.</p>
      <div class="skills-grid" data-reveal-group>
        {skills.map((s) => (
          <div class="skill-card">
            <h3>{s.title}</h3>
            <ul>{s.items.map((i) => <li><span>{i}</span></li>)}</ul>
          </div>
        ))}
        <div class="skill-card skill-card--stacked">
          <h3>Languages</h3>
          <ul>{languages.map((l) => <li><span>{l.name}</span><span class="skill-card__note">{l.level}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 06 EDUCATION ═══════════ -->
  <section class="section" id="education" aria-labelledby="education-title">
    <div class="container">
      <div class="divider"><span class="divider__tick">06 / Education</span></div>
      <div data-reveal>
        <div class="edu-head">
          <h2 id="education-title" class="section-title">University of Maryland, College Park</h2>
        </div>
        <p class="meta">B.S. Mechanical Engineering &amp; B.S. Physics · August 2024 – May 2028 (expected)</p>
        <ul class="edu-facts">
          <li><strong>GPA</strong> 3.97 / 4.00</li>
          <li><strong>Dean's List</strong> every semester</li>
        </ul>

        <h3>Relevant coursework</h3>
        <div class="course-group">
          <p class="course-group__label">Completed</p>
          <ul class="chips">{completed.map((c) => <li><span class="chip chip--muted">{c}</span></li>)}</ul>
        </div>
        <div class="course-group">
          <p class="course-group__label">In progress</p>
          <ul class="chips">{inProgress.map((c) => <li><span class="chip">{c}</span></li>)}</ul>
        </div>

        <h3 style="margin-top:var(--space-10);">Scholarships &amp; awards</h3>
        <ul class="awards">
          {awards.map((a) => (
            <li><span>{a.name}</span>{a.note && <span class="awards__note">{a.note}</span>}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════ 07 CONTACT ═══════════ -->
  <section class="section section--alt section--grid" id="contact" aria-labelledby="contact-title">
    <div class="container--wide">
      <div class="divider"><span class="divider__tick">07 / Contact</span></div>
      <div class="contact-grid" data-reveal>
        <div>
          <h2 id="contact-title" class="section-title">Contact</h2>
          <p class="text-secondary">Email is the fastest way to reach me.</p>
          <div class="downloads" style="margin-top:var(--space-6);">
            <a href="/cv/resume.pdf" class="btn btn--primary" download>Resume (1 page) ↓</a>
            <a href="/cv/cv-full.pdf" class="btn btn--outline" download>Full CV ↓</a>
          </div>
        </div>
        <ul class="contact-list">
          <li><span class="k">Email</span><span class="v"><a href="mailto:juanfelipecortes1202@gmail.com">juanfelipecortes1202@gmail.com</a></span></li>
          <li><span class="k">LinkedIn</span><span class="v"><a href="https://linkedin.com/in/jcortes2" target="_blank" rel="noopener">linkedin.com/in/jcortes2</a></span></li>
          <li><span class="k">GitHub</span><span class="v"><a href="https://github.com/jfcortes1202" target="_blank" rel="noopener">github.com/jfcortes1202</a></span></li>
          <li><span class="k">Institution</span><span class="v">University of Maryland, College Park<small>A. James Clark School of Engineering</small><small>College of Computer, Mathematical, and Natural Sciences</small></span></li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>
