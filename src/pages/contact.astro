---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch — Juan Cortés." currentPage="/contact">
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">Contact</p>
      <h1 class="hero__title">Get in Touch</h1>
      <p class="hero__subtitle">
        Interested in aerospace, defense, energy, or computational modeling?
        I'd love to hear from you.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:3rem;" class="contact-grid">
        <!-- Form -->
        <div class="fade-in">
          <h2>Send a Message</h2>
          <form
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
            style="margin-top:1rem;"
          >
            <div style="margin-bottom:1.25rem;">
              <label for="name" style="display:block; font-size:0.9rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">Name</label>
              <input type="text" id="name" name="name" required
                style="width:100%; padding:0.7rem 0.9rem; border:1px solid var(--border); border-radius:var(--radius-sm); font-size:0.95rem; font-family:var(--font-sans); background:var(--bg-surface); color:var(--text-primary);"
              />
            </div>
            <div style="margin-bottom:1.25rem;">
              <label for="email" style="display:block; font-size:0.9rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">Email</label>
              <input type="email" id="email" name="email" required
                style="width:100%; padding:0.7rem 0.9rem; border:1px solid var(--border); border-radius:var(--radius-sm); font-size:0.95rem; font-family:var(--font-sans); background:var(--bg-surface); color:var(--text-primary);"
              />
            </div>
            <div style="margin-bottom:1.25rem;">
              <label for="subject" style="display:block; font-size:0.9rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">Subject</label>
              <input type="text" id="subject" name="subject"
                style="width:100%; padding:0.7rem 0.9rem; border:1px solid var(--border); border-radius:var(--radius-sm); font-size:0.95rem; font-family:var(--font-sans); background:var(--bg-surface); color:var(--text-primary);"
              />
            </div>
            <div style="margin-bottom:1.25rem;">
              <label for="message" style="display:block; font-size:0.9rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">Message</label>
              <textarea id="message" name="message" rows="5" required
                style="width:100%; padding:0.7rem 0.9rem; border:1px solid var(--border); border-radius:var(--radius-sm); font-size:0.95rem; font-family:var(--font-sans); resize:vertical; background:var(--bg-surface); color:var(--text-primary);"
              ></textarea>
            </div>
            <button type="submit" class="btn btn--primary" style="width:100%; justify-content:center;">
              Send Message
            </button>
          </form>
          <p style="font-size:0.8rem; color:var(--text-tertiary); margin-top:0.75rem;">
            Form powered by Formspree. Replace YOUR_FORM_ID with your actual Formspree endpoint.
          </p>
        </div>

        <!-- Direct contact -->
        <div class="fade-in">
          <h2>Direct Links</h2>
          <div style="margin-top:1rem;">
            <div class="card" style="margin-bottom:1rem;">
              <h3 style="margin-top:0; font-size:1rem; color:var(--steel-blue);">Email</h3>
              <p style="margin:0;">
                <a href="mailto:juanfelipecortes1202@gmail.com">juanfelipecortes1202@gmail.com</a>
              </p>
            </div>
            <div class="card" style="margin-bottom:1rem;">
              <h3 style="margin-top:0; font-size:1rem; color:var(--steel-blue);">LinkedIn</h3>
              <p style="margin:0;">
                <a href="https://linkedin.com/in/jcortes2" target="_blank" rel="noopener">linkedin.com/in/jcortes2</a>
              </p>
            </div>
            <div class="card" style="margin-bottom:1rem;">
              <h3 style="margin-top:0; font-size:1rem; color:var(--steel-blue);">GitHub</h3>
              <p style="margin:0;">
                <a href="https://github.com/jfcortes1202" target="_blank" rel="noopener">github.com/jfcortes1202</a>
              </p>
            </div>
            <div class="card" style="margin-bottom:1rem;">
              <h3 style="margin-top:0; font-size:1rem; color:var(--steel-blue);">Institution</h3>
              <p style="margin:0; color:var(--text-secondary);">
                University of Maryland, College Park<br />
                A. James Clark School of Engineering<br />
                Department of Mechanical Engineering
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr !important;
    }
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(212,168,75,0.15);
  }
</style>
