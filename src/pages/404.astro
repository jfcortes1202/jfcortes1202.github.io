---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist." currentPage="">
  <section class="hero" style="min-height:60vh; display:flex; align-items:center;">
    <div class="container" style="text-align:center;">
      <p style="font-size:5rem; font-weight:700; color:var(--border); margin-bottom:0; line-height:1; font-family:var(--font-serif);">404</p>
      <h1 class="hero__title" style="margin-top:1rem;">Page Not Found</h1>
      <p class="hero__subtitle" style="margin:1rem auto;">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn btn--primary" style="margin-top:1.5rem;">Back to Home</a>
    </div>
  </section>
</BaseLayout>
