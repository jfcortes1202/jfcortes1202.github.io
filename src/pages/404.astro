---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist." currentPage="">
  <section style="min-height:80vh; display:flex; align-items:center; padding-top:var(--nav-height);">
    <div class="container" style="text-align:center;">
      <p style="font-family:var(--font-display); font-size:6rem; font-weight:800; color:var(--border); margin-bottom:0; line-height:1; letter-spacing:-0.05em;">404</p>
      <h1 style="font-size:var(--text-2xl); margin-top:var(--space-4);">Page Not Found</h1>
      <p style="color:var(--text-secondary); margin:var(--space-4) auto; max-width:400px;">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn btn--primary" style="margin-top:var(--space-6);">Back to Home</a>
    </div>
  </section>
</BaseLayout>
