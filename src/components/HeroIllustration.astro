---
/**
 * Hero illustration: section view of Juan's gas-turbine SolidWorks model,
 * traced from a screenshot into stroke polylines (qa/trace-section.cjs →
 * src/data/engine-section.json) and rendered in the site's drawing style.
 *
 * Every stroke carries a `data-ill` role the motion script uses to trace the
 * drawing in on load. With JS off or reduced motion the finished drawing renders.
 * Drawn for the always-dark hero: colours are fixed slate/sky values.
 */
import section from '../data/engine-section.json';

const W = 740;
const H = 440;

// Fit the traced drawing (section.width × section.height) into the viewBox.
const S = 640 / section.width;
const OX = 50;
const OY = (H - section.height * S) / 2;
const f = (n: number) => Math.round(n * 10) / 10;
const tx = (x: number) => f(OX + x * S);
const ty = (y: number) => f(OY + y * S);

// Engine axis (vertical centre of the inlet bell) in source coordinates.
const AXIS_SRC = 112;
const CY = ty(AXIS_SRC);

type Line = number[][];
const lines = section.lines as Line[];
const length = (l: Line) => l.reduce((a, p, i) => (i ? a + Math.hypot(p[0] - l[i - 1][0], p[1] - l[i - 1][1]) : 0), 0);
const bbox = (l: Line) => {
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  for (const [x, y] of l) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
  return { x0, y0, x1, y1 };
};
const inside = (b: ReturnType<typeof bbox>, r: number[]) => b.x0 >= r[0] && b.x1 <= r[2] && b.y0 >= r[1] && b.y1 <= r[3];

// Blade regions in source coordinates (compressor stages, turbine stages).
const BLADE_REGIONS = [[145, 50, 262, 150], [318, 38, 412, 172]];

type Role = 'profile' | 'internal' | 'blade';
const classify = (l: Line): Role => {
  const len = length(l);
  const b = bbox(l);
  if (len < 32 && BLADE_REGIONS.some((r) => inside(b, r))) return 'blade';
  return len >= 70 ? 'profile' : 'internal';
};

const d = (l: Line) => l.map(([x, y], i) => `${i ? 'L' : 'M'}${tx(x)} ${ty(y)}`).join(' ');
const strokes = lines.map((l) => ({ d: d(l), role: classify(l) }));

// ---- Dimensions & labels (source x-ranges of the engine sections) ------
const tick = (x: number, y: number) => `M${f(x - 3)} ${f(y + 3)} L${f(x + 3)} ${f(y - 3)}`;
const hdim = (x1: number, x2: number, y: number) => `M${f(x1)} ${f(y)} L${f(x2)} ${f(y)} ${tick(x1, y)} ${tick(x2, y)}`;
const ext = (x: number, y1: number, y2: number) => `M${f(x)} ${f(y1)} L${f(x)} ${f(y2)}`;

const topDimY = ty(-16);
const sections = [
  { label: 'inlet', x1: 0, x2: 104, top: 10 },
  { label: 'compressor', x1: 120, x2: 262, top: 44 },
  { label: 'combustor · turbine', x1: 288, x2: 416, top: 4 },
  { label: 'exhaust', x1: 418, x2: 532, top: 56 },
];
const botDimY = ty(section.height + 18);
const rDimX = OX - 18;
const inletTop = ty(14);

// Streamlines: into the bellmouth; out of the angled exhaust face.
const flows = [
  `M0 ${ty(70)} C ${tx(-30)} ${ty(70)}, ${tx(-18)} ${ty(80)}, ${tx(2)} ${ty(86)}`,
  `M0 ${ty(154)} C ${tx(-30)} ${ty(154)}, ${tx(-18)} ${ty(144)}, ${tx(2)} ${ty(138)}`,
  `M${tx(528)} ${ty(72)} L${tx(566)} ${ty(52)}`,
  `M${tx(531)} ${ty(94)} L${tx(569)} ${ty(74)}`,
];
---

<svg
  class="hero-ill"
  viewBox={`0 0 ${W} ${H}`}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="hero-ill-title"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <title id="hero-ill-title">Section view of a gas turbine engine CAD model: bellmouth inlet, multi-stage axial compressor, combustor with turbine stages, and an angled exhaust.</title>

  <defs>
    <clipPath id="clip-axis"><rect data-ill="axis-clip" x="0" y="0" width="0" height={H} /></clipPath>
    <clipPath id="clip-flow"><rect data-ill="flow-clip" x="0" y="0" width="0" height={H} /></clipPath>
  </defs>

  <!-- Centreline (dash-dot) -->
  <g clip-path="url(#clip-axis)">
    <path d={`M${OX - 24} ${CY} L${tx(540)} ${CY}`} stroke="#64748B" stroke-width="1" stroke-dasharray="16 5 2 5" />
  </g>

  <!-- Traced section: housings and long profiles, internals, blades -->
  <g stroke="#CBD5E1" stroke-width="1.25">
    {strokes.filter((s) => s.role === 'profile').map((s) => <path data-ill="profile" d={s.d} />)}
  </g>
  <g stroke="#94A3B8" stroke-width="1">
    {strokes.filter((s) => s.role === 'internal').map((s) => <path data-ill="internal" d={s.d} />)}
  </g>
  <g stroke="#60A5FA" stroke-width="1.2">
    {strokes.filter((s) => s.role === 'blade').map((s) => <path data-ill="blade" d={s.d} />)}
  </g>

  <!-- Streamlines (dashed, clip-revealed) -->
  <g clip-path="url(#clip-flow)" stroke="#60A5FA" stroke-opacity="0.55" stroke-width="1" stroke-dasharray="5 4">
    {flows.map((p) => <path d={p} />)}
  </g>

  <!-- Dimensions -->
  <g stroke="#64748B" stroke-width="1">
    {sections.map((s) => (
      <>
        <path data-ill="dim" d={ext(tx(s.x1), ty(s.top) - 8, topDimY + 6)} />
        <path data-ill="dim" d={ext(tx(s.x2), ty(s.top) - 8, topDimY + 6)} />
        <path data-ill="dim" d={hdim(tx(s.x1), tx(s.x2), topDimY)} />
      </>
    ))}
    <path data-ill="dim" d={ext(tx(0), ty(section.height) + 6, botDimY + 6)} />
    <path data-ill="dim" d={ext(tx(532), ty(section.height) + 6, botDimY + 6)} />
    <path data-ill="dim" d={hdim(tx(0), tx(532), botDimY)} />
    <path data-ill="dim" d={`M${rDimX} ${CY} L${rDimX} ${inletTop} ${tick(rDimX, CY)} ${tick(rDimX, inletTop)}`} />
    <path data-ill="dim" d={`M${rDimX - 4} ${inletTop} L${tx(0) - 4} ${inletTop}`} />
  </g>

  <!-- Labels -->
  <g>
    {sections.map((s) => (
      <text data-ill="label" x={(tx(s.x1) + tx(s.x2)) / 2} y={topDimY - 7} text-anchor="middle">{s.label}</text>
    ))}
    <text data-ill="label" x={(tx(0) + tx(532)) / 2} y={botDimY + 16} text-anchor="middle">L</text>
    <text data-ill="label" x={rDimX - 8} y={(CY + inletTop) / 2 + 4} text-anchor="end">r</text>
  </g>
</svg>
