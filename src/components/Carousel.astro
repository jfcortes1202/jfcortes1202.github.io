---
/**
 * Image carousel for CAD parts, drawings and figure sets.
 *
 * Built on a CSS scroll-snap track, so touch swipe, trackpad and scrollbar all
 * work without JS. The script adds previous/next buttons, ← → keys while the
 * carousel has focus, a live "n / N" counter, the active slide's caption, and
 * (optional) a thumbnail strip to jump straight to a slide.
 */
import { media, type Slide } from '../lib/media';

interface Props {
  id: string;
  label: string;          // accessible name, e.g. "Robotic arm parts"
  slides: Slide[];
  paper?: boolean;        // white sheet behind each slide (renders, drawings)
  thumbs?: boolean;
  ratio?: string;         // CSS aspect-ratio of the viewport
}
const { id, label, slides, paper = true, thumbs = false, ratio = '4 / 3' } = Astro.props;
// Placeholder slides (export not supplied yet) skip the manifest lookup.
const items = slides.map((s, i) => ({ ...s, ...(s.placeholder ? {} : media(s.src)), i }));
const total = items.length;
---

<section class:list={['carousel', { 'carousel--paper': paper }]} id={id} aria-roledescription="carousel" aria-label={label} data-carousel>
  <div class="carousel__viewport" style={`aspect-ratio:${ratio};`}>
    <ul class="carousel__track" tabindex="0" aria-label={`${label}, ${total} slides. Use the arrow keys to move between them.`}>
      {items.map((s) => (
        <li class="carousel__slide" role="group" aria-roledescription="slide" aria-label={`${s.i + 1} of ${total}: ${s.caption}`} data-caption={s.caption}>
          {s.placeholder ? (
            <div class="carousel__placeholder" role="img" aria-label={`${s.placeholder.kind} placeholder: ${s.placeholder.label}`}>
              <span class="placeholder__kind">{s.placeholder.kind}</span>
              <span class="carousel__placeholder-name">{s.caption.split(' · ')[0]}</span>
              <span class="carousel__placeholder-note">Export pending</span>
            </div>
          ) : (
            <img src={s.src} alt={s.alt ?? s.caption} width={s.w} height={s.h} loading={s.i === 0 ? 'eager' : 'lazy'} decoding="async" />
          )}
        </li>
      ))}
    </ul>
    {total > 1 && (
      <>
        <button class="carousel__btn carousel__btn--prev" type="button" aria-controls={id} aria-label="Previous slide" data-prev>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="carousel__btn carousel__btn--next" type="button" aria-controls={id} aria-label="Next slide" data-next>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </>
    )}
  </div>

  <div class="carousel__bar">
    <p class="carousel__caption" aria-live="polite" data-caption-out>{items[0]?.caption}</p>
    {total > 1 && <p class="carousel__count" aria-hidden="true"><span data-index>1</span> / {total}</p>}
  </div>

  {thumbs && total > 1 && (
    <ol class="carousel__thumbs" aria-label={`${label}: jump to slide`}>
      {items.map((s) => (
        <li>
          <button type="button" class="carousel__thumb" data-goto={s.i} aria-label={`Show ${s.caption}`} aria-current={s.i === 0 ? 'true' : undefined}>
            {s.placeholder
              ? <span class="carousel__thumb-ph" aria-hidden="true">{s.caption.split(' · ')[0]}</span>
              : <img src={s.src} alt="" width={s.w} height={s.h} loading="lazy" decoding="async" />}
          </button>
        </li>
      ))}
    </ol>
  )}
</section>

<script>
  function setup(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.carousel__track')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const out = root.querySelector<HTMLElement>('[data-caption-out]');
    const idx = root.querySelector<HTMLElement>('[data-index]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    let current = 0;

    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    const update = (n: number) => {
      if (n === current && out?.textContent) return;
      current = n;
      if (out) out.textContent = slides[n].dataset.caption ?? '';
      if (idx) idx.textContent = String(n + 1);
      if (prev) prev.disabled = n === 0;
      if (next) next.disabled = n === slides.length - 1;
      thumbs.forEach((t, k) => {
        if (k === n) { t.setAttribute('aria-current', 'true'); t.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
        else t.removeAttribute('aria-current');
      });
    };

    // Track which slide is centred in the viewport.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) update(slides.indexOf(e.target as HTMLElement));
    }, { root: track, threshold: 0.6 });
    slides.forEach((s) => io.observe(s));

    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.goto))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
      else if (e.key === 'Home') { e.preventDefault(); go(0); }
      else if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    });
    if (prev) prev.disabled = true;
  }
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(setup);
</script>
